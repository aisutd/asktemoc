# Vercel: run `vercel link` / `vercel deploy` from the repo root, not from
# frontend/, so Root Directory "frontend" matches once (avoids frontend/frontend).

# Local dev: backend on your machine
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production on Vercel: omit NEXT_PUBLIC_API_BASE_URL so the app uses same-origin
# /api/proxy (see next.config rewrites). Never set it to http://localhost — the
# browser would call the user’s machine, not Cloud Run.

# Used at build time for rewrites (also in .env.production and vercel.json env).
# ASKTEMOC_API_ORIGIN=https://asktemoc-api-422855032073.us-central1.run.app

# Optional: call Cloud Run directly from the browser (requires CORS on the API).
# NEXT_PUBLIC_API_BASE_URL=https://asktemoc-api-422855032073.us-central1.run.app

# Vercel Dashboard → Environment Variables: for Production/Preview, delete any
# NEXT_PUBLIC_API_BASE_URL=http://localhost... unless you truly mean it.

# Browser login for visitors: Vercel Dashboard → Project → Deployment Protection →
# enable “Vercel Authentication” (or Password on Pro). Unauthenticated users are
# redirected to Vercel’s sign-in page before the app loads.
