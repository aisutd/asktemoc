# Copy to frontend/.env.local (gitignored) and fill in. Never commit real values.
# Step-by-step provider setup: docs/AUTH_SETUP.md

# --- Auth.js -----------------------------------------------------------------
# Required. Encrypts the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Microsoft Entra ID (UT Dallas Microsoft 365): the production sign-in path.
# Enabled when all three are set. The issuer must be UTD's tenant:
#   https://login.microsoftonline.com/8d281d1d-9c4d-4bf7-b16e-032d15de9f6c/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Google: handy in development. Enabled when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who may sign in (case-insensitive). Only this domain is admitted.
ALLOWED_EMAIL_DOMAIN=utdallas.edu

# --- Backend -----------------------------------------------------------------
# Required. Signs the 5-minute tokens the Next server sends to FastAPI.
# Must equal BACKEND_JWT_SECRET in backend/.env (at least 32 characters).
BACKEND_JWT_SECRET=

# Where the Next server reaches FastAPI. Defaults to http://localhost:8000.
# The browser never calls it directly.
# ASKTEMOC_API_ORIGIN=http://localhost:8000

# Production rewrite target (next.config / vercel.json). Not used for browser fetch.
# ASKTEMOC_API_ORIGIN=https://asktemoc-api-422855032073.us-central1.run.app
