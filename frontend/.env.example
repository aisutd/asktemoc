# Local dev: backend on your machine
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production on Vercel: omit NEXT_PUBLIC_API_BASE_URL to use /api/proxy → Cloud Run.
# Optional: set ASKTEMOC_API_ORIGIN if the API moves (default is asktemoc Cloud Run).
# ASKTEMOC_API_ORIGIN=https://asktemoc-api-422855032073.us-central1.run.app

# Optional: call Cloud Run directly from the browser (requires CORS on the API).
# NEXT_PUBLIC_API_BASE_URL=https://asktemoc-api-422855032073.us-central1.run.app

# Browser login for visitors: Vercel Dashboard → Project → Deployment Protection →
# enable “Vercel Authentication” (or Password on Pro). Unauthenticated users are
# redirected to Vercel’s sign-in page before the app loads.
