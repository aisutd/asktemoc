# Copy to frontend/.env.local only if you need to override a default; the app
# runs locally without any env vars.

# Where the same-origin /api/proxy rewrites (next.config.ts) forward to.
# `next dev` defaults to the local API at http://localhost:8000; production builds
# use the Cloud Run origin from .env.production and vercel.json.
# ASKTEMOC_API_ORIGIN=http://localhost:8000

# Optional: call an API origin directly from the browser instead of the proxy
# (requires CORS on that API). Never set it to http://localhost in Production:
# the browser would call the visitor's machine, not Cloud Run.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Vercel: run `vercel link` / `vercel deploy` from the repo root, not from
# frontend/, so Root Directory "frontend" matches once (avoids frontend/frontend).

# Browser login for visitors: Vercel Dashboard -> Project -> Deployment Protection ->
# enable "Vercel Authentication" (or Password on Pro). Unauthenticated users are
# redirected to Vercel's sign-in page before the app loads. App-level sign-in is
# planned (10-week plan, Weeks 2-4).
