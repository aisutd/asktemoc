# Copy to frontend/.env.local (gitignored) and fill in. Never commit real values.
# Step-by-step provider setup: docs/AUTH_SETUP.md

# --- Auth.js -----------------------------------------------------------------
# Required. Encrypts the session cookie. Generate with `npx auth secret` or
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Microsoft Entra ID (UT Dallas Microsoft 365): the production sign-in path.
# Enabled when all three are set. The issuer must be tenant-specific:
#   https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Google: handy in development. Enabled when both are set. Note that most UTD
# students have no Google account on utdallas.edu, so use ALLOWED_EMAILS below
# to let teammates in with personal accounts while developing.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who may sign in (case-insensitive). ALLOWED_EMAILS is a comma-separated list
# of extra addresses honoured only under `npm run dev`; the API needs the same
# list (and ENVIRONMENT=development) for those accounts to get answers.
ALLOWED_EMAIL_DOMAIN=utdallas.edu
ALLOWED_EMAILS=

# --- Backend -----------------------------------------------------------------
# Required. Signs the short-lived tokens the Next server sends to the API; must
# equal BACKEND_JWT_SECRET in backend/.env (at least 32 characters).
BACKEND_JWT_SECRET=

# Where the Next server reaches the FastAPI app. Defaults to http://localhost:8000.
# The browser never calls it directly.
# ASKTEMOC_API_ORIGIN=http://localhost:8000
