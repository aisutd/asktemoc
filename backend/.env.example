# Copy to backend/.env and fill in. backend/.env is gitignored; never commit it.
# Every value here is optional unless marked required; defaults are shown.

ENVIRONMENT=development

# --- LLM + embeddings ------------------------------------------------------
# If OPENAI_API_KEY is set, chat and embeddings use OpenAI; otherwise Ollama.
# Switching provider (or embedding model) requires re-running
# `python scripts/seed_catalog.py`: vectors from different models don't mix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Storage ----------------------------------------------------------------
# Relative paths resolve against backend/. Postgres works by changing the URL,
# e.g. postgresql+psycopg://user:pass@host/asktemoc (install the driver).
DATABASE_URL=sqlite:///./asktemoc.db
DB_ECHO=false
CHROMA_PERSIST_DIRECTORY=./app/chroma_db
CHROMA_COLLECTION_NAME=asktemoc_collection

# --- HTTP -------------------------------------------------------------------
# Comma-separated. The browser only talks to the Next.js server, so this rarely
# needs more than the web origin.
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------
# Required: same value as BACKEND_JWT_SECRET in frontend/.env.local, at least
# 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_JWT_SECRET=
ALLOWED_EMAIL_DOMAIN=utdallas.edu
# Comma-separated extra addresses; only honoured when ENVIRONMENT=development.
ALLOWED_EMAILS=
# Development only: skip token checks and act as dev@utdallas.edu, so scripts can
# call /api/chat directly. The API refuses to start with this set in any other
# ENVIRONMENT.
AUTH_DISABLED=false
