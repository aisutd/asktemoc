# Environment Configuration Template

# Database Configuration
# SQLite (default):
DATABASE_URL=sqlite:///./asktemoc.db

# PostgreSQL (optional):
# DATABASE_URL=postgresql://user:password@localhost/asktemoc

# Enable database query logging
DB_ECHO=false

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./app/chroma_db
CHROMA_COLLECTION_NAME=asktemoc_collection

# LLM chat (defaults to OpenAI; set OPENAI_API_KEY)
# Force local Ollama instead: LLM_PROVIDER=ollama
LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Comma-separated browser origins (production: your hosted front-end URL)
# CORS_ORIGINS=http://localhost:3000,https://your-app.example.com

# FastAPI Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
